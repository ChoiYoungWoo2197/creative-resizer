# clean_pipeline 테스트용 이미지 — 운영 환경에 사용하지 않는다.
#
# 로컬 실행 (권장):
#   python -m pytest tests/clean_pipeline/ -v
#
# 컨테이너 실행:
#   docker build -t creative-worker-verify -f worker/Dockerfile.verify .
#   docker run --rm creative-worker-verify
#
# 빌드 컨텍스트는 프로젝트 루트(.)를 사용해야 tests/와 conftest.py를 포함할 수 있다.

FROM python:3.11-slim

WORKDIR /app

# psd-tools / Pillow 네이티브 의존성 (운영 Dockerfile과 동일)
RUN apt-get update && apt-get install -y \
    libffi-dev \
    libjpeg-dev \
    zlib1g-dev \
    liblcms2-2 \
    && rm -rf /var/lib/apt/lists/*

# 운영 의존성 설치
COPY worker/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 테스트 의존성 추가
RUN pip install --no-cache-dir pytest pytest-timeout

# Worker 소스 + 테스트 파일 복사
COPY worker/ /app/
COPY tests/ /app/tests/
COPY conftest.py /app/conftest.py

ENV PYTHONPATH=/app

CMD ["python", "-m", "pytest", "tests/clean_pipeline/", "-v"]
